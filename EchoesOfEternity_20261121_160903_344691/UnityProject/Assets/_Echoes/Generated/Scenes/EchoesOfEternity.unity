  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.17, g: 0.11, b: 0.05, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 27
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: 'You slip into an ancient jungle temple and the great door grinds shut behind you.


    Somewhere inside lie three keys - SUN, LEAF and WAVE - that unlock the chamber of the Heart of Eternity. Take the Heart and the entrance will open again.


    Your hourglass lets you step between the ruined PRESENT and the intact PAST of this place. What blocks your path in one time may be open in the other.


    WASD move   -   Mouse look   -   E interact

    Q shift time   -   Esc pause'
